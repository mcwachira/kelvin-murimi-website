# Production environment for the Dockerized app — copy to .env.production
# and fill in real values. Never commit .env.production.
#
# Database: Supabase Postgres (Session pooler / port 6543 recommended for
# serverless-style connections; direct :5432 connection also works).
# Find this under Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Sanity
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_PREVIEW_TOKEN=
SANITY_REVALIDATE_SECRET=

# Better Auth (admin dashboard)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-production-domain.com
ADMIN_EMAIL=

# Contact form fallback (used only if DATABASE_URL write fails)
CONTACT_EMAIL=

# Canonical URL — sitemap, OG/Twitter tags, robots.txt
PUBLIC_SITE_URL=https://your-production-domain.com

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Port the container listens on internally (see docker-compose.prod.yml)
PORT=3000
