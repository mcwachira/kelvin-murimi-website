# Example environment variables (copy to .env.local and fill values)
# WARNING: do NOT commit real secrets. Use platform secret managers for production.

# Sanity (read-only client will work without write tokens)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_WRITE_TOKEN=
SANITY_PREVIEW_TOKEN=
SANITY_REVALIDATE_SECRET=
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Better Auth (admin + auth)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
ADMIN_EMAIL=

# Database (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/kelvin_portfolio

# Contact / site settings
CONTACT_EMAIL=
PUBLIC_SITE_URL=http://localhost:3000

# Vercel purge token (used by /api/revalidate to purge edge caches)
VERCEL_PURGE_TOKEN=

# Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Local dev port override
PORT=3000
